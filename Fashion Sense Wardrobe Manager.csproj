<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <RootNamespace>FashionSenseWardrobeManager</RootNamespace>
    <AssemblyName>FashionSenseWardrobeManager</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Exclude the pre-rebrand assembly if it remains in a local build directory. -->
    <IgnoreModFilePaths>FashionSenseOutfitPreview.dll</IgnoreModFilePaths>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" />
  </ItemGroup>

</Project>
